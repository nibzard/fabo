# Steel.dev Configuration (Required for screenshot mode)
STEEL_API_KEY=your-steel-api-key-here

# Platform API Keys (Configure as needed)
GITHUB_TOKEN=your-github-personal-access-token
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# LLM API Keys (Required for screenshot mode - at least one)
# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenAI GPT-4V (alternative)
OPENAI_API_KEY=sk-your-openai-api-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./fabo.db

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Screenshot Storage
SCREENSHOTS_PATH=./screenshots

# API Server (optional)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-in-production

# Scheduler
ENABLE_SCHEDULER=true
DEFAULT_CHECK_INTERVAL=3600  # seconds
